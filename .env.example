DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/beauty_db
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-password
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
GEMINI_API_KEY=replace-with-gemini-api-key

SALON_NAME=Lena's nail studio
SALON_ADDRESS=Street address, Rome, Italy
SALON_LATITUDE=
SALON_LONGITUDE=
# Optional; if unset, the app builds a Google Maps search URL from name and address.
GOOGLE_MAPS_URL=

# Optional human-reply bridge. Forwarding is enabled by default when an admin ID is set.
ADMIN_TELEGRAM_CHAT_ID=
FORWARD_CLIENT_MESSAGES_TO_ADMIN=true
